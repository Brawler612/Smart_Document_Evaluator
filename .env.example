# Copy this file to `.env` in the same folder as package.json, then fill in values from:
# Supabase Dashboard → Project Settings → API
#
# Required for Google sign-in and real data (placeholders in the app cannot open OAuth).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: auto-assign roles by Google email at sign-in (comma-separated)
# Example:
# VITE_ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com
# VITE_TEACHER_EMAILS=teacher1@gmail.com,teacher2@gmail.com
VITE_ADMIN_EMAILS=
VITE_TEACHER_EMAILS=

# Student uploads: default bucket is student-submissions (see docs/supabase-storage-student-submissions.sql).
# Set to off / false / empty to force inline data URLs only (not recommended for large PDFs).
VITE_SUBMISSION_STORAGE_BUCKET=student-submissions
