# To publish a hosted build: set the same VITE_* keys in your host’s env UI; see DEPLOY.md.
# Never commit real .env to git.
#
# -----------------------------------------------------------------------------
# Who needs this file?
#
# • People using your deployed site: they do NOT add .env — you set VITE_* vars
#   where the site is built; those values are baked into the JS bundle.
#
# • Running `npm run dev` on YOUR machine: copy this file to `.env` and fill in values.
#
# • If OAuth fails on production: fix Redirect URLs / Site URL for that hostname in Supabase,
#   or test locally with `npm run dev` and `http://localhost:5173/**` in Redirect URLs.
#
# • DATABASE_URL is only for `npm run db:apply` on a trusted machine — never
#   ship it to end users or commit it.
# -----------------------------------------------------------------------------

# Supabase Dashboard → Project Settings → API (same project for everyone using the app)

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: auto-assign roles by email at sign-in (comma-separated)
# VITE_ADMIN_EMAILS=admin@school.edu
# VITE_TEACHER_EMAILS=teacher@school.edu
VITE_ADMIN_EMAILS=
VITE_TEACHER_EMAILS=

# Optional — only these email domains allowed for accounts that resolve as "student".
# Matches the email Google returns (e.g. campus @cit.edu or @citu.edu.ph). Comma-separated, no @.
# Leave empty to allow any email for students.
# VITE_STUDENT_EMAIL_DOMAINS=cit.edu,citu.edu.ph

# Student uploads bucket (see docs/supabase-storage-student-submissions.sql)
VITE_SUBMISSION_STORAGE_BUCKET=student-submissions

# Optional — Google Gemini for teacher "Run AI Inspection" (refines rubric scores + narrative summary).
# Prefer a backend URL so your API key never ships in the browser bundle:
#   VITE_GEMINI_EVAL_URL=https://your-server.example.com/api/evaluate-document
#   POST JSON body: { "docType": "SRS", "content": "<text>", "template": [ { "name","score","max","comment" } ] }
#   Response JSON: { "executiveSummary": "...", "criteria": [ { "name","score","comment" } ] } (one row per rubric name; score 0..max from template)
# Dev-only alternative (key is public to anyone who downloads your JS — not for production):
#   VITE_GEMINI_API_KEY=your_key_from_ai_google_dev
#   VITE_GEMINI_MODEL=gemini-2.5-flash
# Create the API key in Google AI Studio for the same project where your billing / credit applies.
# After billing + key: npm run verify:gemini
# VITE_GEMINI_EVAL_URL=
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=

# Optional — local schema apply only (never VITE_, never commit)
# DATABASE_URL=postgresql://postgres.[ref]:PASSWORD@db.[ref].supabase.co:5432/postgres
# With DATABASE_URL: npm run db:apply (full schema) or npm run db:fix-rls (users RLS recursion fix only)
